# Production environment variables for Chabokan / Node.js
NODE_ENV=production
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Leave empty unless a separate frontend origin is genuinely required.
CORS_ORIGIN=
JSON_BODY_LIMIT=50mb

# PostgreSQL - create a PostgreSQL database on Chabokan and put its connection string here.
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set false only if your provider does not use SSL.
DATABASE_SSL=true
DB_POOL_MAX=10
STORAGE_COLLECTION=poultryData

# Remote access session security. Keep this secret and local; never put it in VITE_* variables.
# A stable fallback derived from DATABASE_URL is used if this is omitted, but an independent random secret is preferred.
NIR_SESSION_SECRET=replace_with_a_long_random_secret
# Default: 12 hours. Minimum accepted by the server: 15 minutes.
NIR_SESSION_TTL_MS=43200000
