# Production environment variables for Chabokan / Node.js
NODE_ENV=production
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Optional: comma-separated allowed browser origins.
CORS_ORIGIN=
JSON_BODY_LIMIT=50mb

# Server-side Firestore proxy
FIREBASE_PROJECT_ID=spartan-metric-tzp2g
FIRESTORE_DATABASE_ID=ai-studio-remixart-7582d439-4115-4be9-bd25-4bf656afcfac
FIRESTORE_PROXY_COLLECTION=poultryData
# Paste the Firebase service-account JSON as one environment variable. Never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}
