# Production environment variables for NIR / Node.js
NODE_ENV=production
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Leave empty unless a separate frontend origin is genuinely required.
CORS_ORIGIN=
JSON_BODY_LIMIT=50mb

# Local PostgreSQL - this remains the primary writable database on the Mini PC.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
DB_POOL_MAX=10
STORAGE_COLLECTION=poultryData

# Session security for the local NIR server.
NIR_SESSION_SECRET=replace_with_a_long_random_secret
NIR_SESSION_TTL_MS=43200000

# Supabase cloud replica. Do not put secrets in VITE_* variables.
# CLOUD_SYNC_URL should be the function root, for example:
# https://YOUR_PROJECT_REF.supabase.co/functions/v1/nir-api
CLOUD_SYNC_URL=
# Must match the NIR_CLOUD_SYNC_TOKEN secret configured in the Supabase function.
CLOUD_SYNC_TOKEN=
