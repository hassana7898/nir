rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    match /poultryData/{itemId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['value']) && request.resource.data.value is string;
    }
  }
}
