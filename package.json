{
  "name": "factory-remittance-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node -r ./storageBootstrap.cjs dist/server.cjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "cloudflare:build": "vite build",
    "cloudflare:deploy": "npm run cloudflare:build && npx wrangler deploy"
  },
  "dependencies": {
    "@google/genai": "^1.42.0",
    "@fontsource/vazirmatn": "^5.2.6",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pdfjs-dist": "3.11.174",
    "pg": "^8.16.3",
    "react": "^18.2.0",
    "react-date-object": "^2.1.9",
    "react-dom": "^18.2.0",
    "react-multi-date-picker": "^4.5.2",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.7",
    "sortablejs": "^1.15.2",
    "sweetalert2": "^11.10.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "esbuild": "^0.28.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "tsx": "^4.20.5"
  }
